generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String?
  role      String   @default("user")
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id               Int           @id @default(autoincrement())
  title            String
  slug             String        @unique
  description      String?
  shortDescription String?
  price            Float
  discountPrice    Float?
  stock            Int           @default(0)
  sku              String?       @unique
  brand            String?
  rating           Float?        @default(0)
  categoryId       Int?
  category         Category?     @relation(fields: [categoryId], references: [id])
  featured         Boolean       @default(false)
  bestSeller       Boolean       @default(false)
  newArrival       Boolean       @default(false)
  status           ProductStatus @default(DRAFT)
  images           String[]      @default([])
  imagePublicIds   String[]      @default([])
  sizes            String[]      @default([])
  colors           String[]      @default([])
  tags             String[]      @default([])
  orderItems       OrderItem[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

enum ProductStatus {
  DRAFT
  ACTIVE
}

model Order {
  id                Int         @id @default(autoincrement())
  userId            Int?
  user              User?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             OrderItem[]
  subtotal          Float
  shipping          Float?      @default(0)
  total             Float
  status            String      @default("pending")
  shippingAddress   String?
  phone             String?
  email             String?
  paymentMethod     String?
  notes             String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  orderId       Int
  order         Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  price         Float
  selectedColor String?
  selectedSize  String?
  createdAt     DateTime @default(now())
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique
  userId    Int
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model SiteSettings {
  id              Int      @id @default(1)
  siteName        String   @default("Royal Shopping")
  tagline         String   @default("Luxury essentials for every occasion.")
  logoUrl         String?
  heroTitle       String   @default("Discover elevated style with Royal Shopping.")
  heroSubtitle    String   @default("Elevate your wardrobe with timeless dresses, statement jackets, and carefully selected home accents designed for modern luxury.")
  heroImageUrl    String?
  heroCtaText     String   @default("Shop now")
  whatsappNumber  String   @default("+919876543210")
  instagramUrl    String?
  facebookUrl     String?
  twitterUrl      String?
  pinterestUrl    String?
  contactEmail    String   @default("hello@royalshopping.com")
  contactPhone    String   @default("+91 98765 43210")
  contactAddress  String   @default("123 Royal Boulevard, Suite 400, Mumbai, India")
  updatedAt       DateTime @updatedAt
}

model Review {
  id        Int      @id @default(autoincrement())
  productId Int
  userName  String
  userEmail String?
  rating    Int      @default(5)
  comment   String
  createdAt DateTime @default(now())
}

model Coupon {
  id         Int      @id @default(autoincrement())
  code       String   @unique
  discount   Float    // percentage or fixed amount
  type       String   @default("percentage") // percentage | fixed
  minSpend   Float?   @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

